{
  "expo": {
    "name": "Circadia",
    "slug": "circadia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "circadia",
    "splash": {
      "backgroundColor": "#0E1424",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.circadia.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1424"
      },
      "package": "app.circadia.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Cardiac-App"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
