{
  "name": "circadia",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "gen:types": "npx supabase gen types typescript --linked --schema public > src/types/db.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "gen:legal": "node scripts/gen-legal.mjs",
    "gen:sounds": "node scripts/gen-sounds.mjs",
    "gen:brand": "node scripts/gen-brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.2",
    "expo-av": "~14.0.7",
    "expo-battery": "~8.0.1",
    "expo-crypto": "~13.0.2",
    "expo-font": "~12.0.10",
    "expo-gl": "^14.0.2",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-notifications": "^0.28.19",
    "expo-sensors": "~13.0.9",
    "expo-sharing": "~12.0.1",
    "expo-speech": "^11.7.0",
    "expo-status-bar": "~1.12.1",
    "expo-store-review": "~7.0.2",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "^15.2.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^3.8.0",
    "react-native-web": "^0.19.13",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@types/three": "^0.166.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.4",
    "typescript": "~5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": false
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/__mocks__/async-storage.ts",
      "^react-native$": "<rootDir>/src/__mocks__/react-native.ts",
      "^./supabase$": "<rootDir>/src/__mocks__/supabase.ts",
      "^expo-sensors$": "<rootDir>/src/__mocks__/expo-sensors.ts"
    },
    "testRegex": "src/.*\\.test\\.ts$"
  },
  "private": true
}
