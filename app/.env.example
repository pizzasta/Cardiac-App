# Circadia environment variables (Expo).
# Expo inlines any var prefixed EXPO_PUBLIC_ into the client bundle at build
# time. Copy this file to `.env` and fill in real values. All are OPTIONAL —
# the app runs without them (auth falls back to an on-device account).

# ── Supabase (email/password + Google OAuth + persistent sessions) ──────────
# Project Settings → API. The anon key is safe to ship to clients (RLS guards
# your data). When BOTH are set, Supabase becomes the auth backend.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Google OAuth (LEGACY, only used when Supabase is NOT configured) ─────────
# With Supabase on, configure Google in the Supabase dashboard instead
# (Authentication → Providers → Google) — you do NOT need these.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Optional: AI features (Pulse chat / readings) ───────────────────────────
# Recommended: deploy the Supabase Edge Function (supabase/functions/pulse) and
# point this at its URL. The key + system prompt stay server-side; the client
# only sends the user's data. (Uses EXPO_PUBLIC_SUPABASE_ANON_KEY for auth.)
# EXPO_PUBLIC_PULSE_FN=https://YOUR-PROJECT-ref.functions.supabase.co/pulse
#
# Alternatives:
#   EXPO_PUBLIC_PULSE_ENDPOINT= # a generic proxy that takes a client-built prompt
#   EXPO_PUBLIC_ANTHROPIC_API_KEY= # dev only — this bundles into the client
